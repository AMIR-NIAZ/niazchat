# Backend API base URL (no trailing slash). Example: http://192.168.1.10:3000
# The backend registers controllers at the root (no /api prefix).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Socket.IO origin. The backend has no WS namespace; defaults to EXPO_PUBLIC_API_URL when unset.
# EXPO_PUBLIC_WS_URL=http://localhost:3000

# Backend serves avatars statically under /uploads. Override only if media is hosted elsewhere.
# EXPO_PUBLIC_UPLOADS_BASE_URL=http://localhost:3000/uploads
