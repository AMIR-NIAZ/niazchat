{
  "expo": {
    "name": "NiazChat",
    "slug": "niazchat-mobile",
    "version": "1.0.0",
    "scheme": "niazchat",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-sharing",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow NiazChat to find which of your contacts are already on the app. Contacts are matched on request and never stored."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow niazchat to record voice messages"
        }
      ],
      "expo-status-bar",
      "expo-video",
      "expo-asset",
      "expo-sqlite"
    ]
  }
}
