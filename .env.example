# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Host port used by docker-compose (the container always listens on 3000).
APP_PORT=3000
# Port the NestJS app (HTTP + Socket.IO) listens on.
PORT=3000
NODE_ENV=production
# Set to "true" to return real OTP codes instead of the fixed development code.
PRODUCTION=false
# for run seeders
RUN_SEED=true
# ---------------------------------------------------------------------------
# PostgreSQL (TypeORM)
# HOST_DB/PORT_DB are overridden to postgres:5432 inside docker-compose.
# ---------------------------------------------------------------------------
TYPE_DB=postgres
HOST_DB=localhost
PORT_DB=5432
USERNAME_DB=postgres
PASSWORD_DB=postgres
DATABASE_DB=niazchat
AUTOLOADENTITIES=true
# Keep false in production: schema changes are applied by TypeORM migrations.
SYNCHRONIZE=false

# ---------------------------------------------------------------------------
# Redis / BullMQ
# HOST/PORT are overridden to redis:6379 inside docker-compose.
# Leave REDIS_PASSWORD empty to run Redis without authentication.
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret

# ---------------------------------------------------------------------------
# Attachments (chat files)
# ---------------------------------------------------------------------------
# 20 MiB per image/file, 100 MiB per video; the 200 MiB message cap is a code
# constant. Videos are probed with ffprobe (ffmpeg is installed in the image).
UPLOAD_MAX_FILE_SIZE=20971520
UPLOAD_MAX_VIDEO_SIZE=104857600
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,gif,pdf,doc,docx,xls,xlsx,ppt,pptx,txt,csv,md,rtf,zip,rar,7z,tar,gz,mp3,wav,ogg,m4a,opus,mp4,mov,webm,mkv,avi
# Persistent directory (mounted as storage_data in docker-compose.dev.yml).
STORAGE_DIR=./storage
# HMAC secret for short-lived signed video stream URLs (set in production).
# Never reuse ACCESS_TOKEN_SECRET here.
ATTACHMENT_STREAM_SECRET=change-me-stream-secret
ATTACHMENT_STREAM_URL_TTL_MS=600000
# Cleanup tuning (defaults shown): 6 h orphan TTL, 24 h deleted-message TTL, 30 min interval.
ATTACHMENT_ORPHAN_TTL_MS=21600000
ATTACHMENT_DELETED_TTL_MS=86400000
ATTACHMENT_CLEANUP_INTERVAL_MS=1800000
